{
  "name": "zappr",
  "version": "0.3.1",
  "description": "Cliente desktop moderno para WhatsApp Web (Electron), com suporte a múltiplas sessões isoladas, distribuição inteligente de links e controle de áudio individual.",
  "main": "app/index.js",
  "desktopName": "zappr.desktop",
  "homepage": "https://github.com/pedruhb/Zappr",
  "author": {
    "name": "pedruhb",
    "email": "phbservicesbrasil@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "start": "electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.38.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "app.zappr.desktop",
    "productName": "Zappr",
    "executableName": "zappr",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zappr"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": {
      "provider": "github",
      "owner": "pedruhb",
      "repo": "Zappr",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}